{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiz.space/schemas/character-registry.schema.json",
  "title": "HAIZ Unified Character & Mascot Registry Contract",
  "type": "object",
  "required": ["schema", "characters"],
  "properties": {
    "schema": { "const": "haiz-character-registry/1" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "glb", "rigType", "joints", "heightM", "license", "fictionalOnly"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["human-avatar", "npc", "mascot", "creature"] },
          "glb": { "type": "string", "pattern": "\\.glb$" },
          "rigType": { "enum": ["makehuman-51", "rigify-22", "toon-18", "static-mascot", "procedural"] },
          "joints": { "type": "integer", "minimum": 0 },
          "heightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.0 },
          "license": { "type": "string", "minLength": 2 },
          "fictionalOnly": { "const": true },
          "privacyNote": { "type": "string" }
        }
      }
    }
  }
}
