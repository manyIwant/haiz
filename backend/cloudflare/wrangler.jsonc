{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haiz-backend",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".generated/assets", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "vars": { "PUBLIC_ORIGIN": "https://haiz-backend.haiz-world-prototype.workers.dev", "REGISTRATION": "1" },
  "durable_objects": { "bindings": [{ "name": "HAIZ_DB", "class_name": "HaizBackend" }] },
  "migrations": [{ "tag": "v1-sqlite", "new_sqlite_classes": ["HaizBackend"] }]
}
