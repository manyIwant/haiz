# Load these into the Node process using Node 22: node --env-file=world/pilot/.env world/pilot/server.mjs
HAIZ_PUBLIC_ORIGIN=https://haiz-demo.example.org
HAIZ_BEHIND_PROXY=1
HAIZ_DATA_DIR=/var/lib/haiz-pilot
PORT=8790
# For local TLS validation instead of a reverse proxy, remove BEHIND_PROXY and set:
# HAIZ_TLS_CERT=/private/path/server-cert.pem
# HAIZ_TLS_KEY=/private/path/server-key.pem
