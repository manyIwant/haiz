{
  "colors": {
    "background-app": "#f8f7f4",
    "text-primary": "#292e2a",
    "text-secondary": "#626e62",
    "highlight": "#293f36",
    "border-hairline": "#dddbd6",
    "tap-active": "rgba(41, 63, 54, 0.06)",
    "white": "#ffffff"
  },
  "cssVariables": {
    "--radius-inline": "4px",
    "--radius-sheet": "8px",
    "--border-width-hairline": "1px",
    "--icon-stroke-width": "1.5px",
    "--nav-height": "44px",
    "--tabbar-height": "83px",
    "--safe-bottom": "34px",
    "--safe-top": "44px"
  },
  "typography-language": {
    "body": {
      "family": "Inter, \"Noto Sans SC\", sans-serif",
      "script_coverage": ["Latin", "CJK"],
      "weights": [400, 500, 600],
      "source_type": "google_fonts",
      "source_evidence": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap; https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&display=swap"
    }
  },
  "typography": {
    "roles": {
      "display": {
        "font-family": "var(--font-family-body)",
        "font-size": "24px",
        "font-weight": "600",
        "line-height": "1.3",
        "letter-spacing": "-0.02em"
      },
      "h1": {
        "font-family": "var(--font-family-body)",
        "font-size": "20px",
        "font-weight": "600",
        "line-height": "1.4",
        "letter-spacing": "-0.01em"
      },
      "h2": {
        "font-family": "var(--font-family-body)",
        "font-size": "16px",
        "font-weight": "600",
        "line-height": "1.5",
        "letter-spacing": "0"
      },
      "body": {
        "font-family": "Inter, \"Noto Sans SC\", sans-serif",
        "font-size": "15px",
        "font-weight": "400",
        "line-height": "1.6",
        "letter-spacing": "0"
      },
      "body-medium": {
        "font-family": "var(--font-family-body)",
        "font-size": "15px",
        "font-weight": "500",
        "line-height": "1.6",
        "letter-spacing": "0"
      },
      "label": {
        "font-family": "var(--font-family-body)",
        "font-size": "13px",
        "font-weight": "500",
        "line-height": "1.4",
        "letter-spacing": "0.01em"
      },
      "caption": {
        "font-family": "var(--font-family-body)",
        "font-size": "12px",
        "font-weight": "400",
        "line-height": "1.4",
        "letter-spacing": "0.02em"
      }
    }
  },
  "spacing": {
    "spacing-micro": "4px",
    "spacing-tight": "8px",
    "spacing-snug": "12px",
    "spacing-base": "16px",
    "spacing-comfortable": "20px",
    "spacing-loose": "24px",
    "spacing-section": "32px"
  },
  "motion": {
    "easing-elastic": "cubic-bezier(0.32, 0.72, 0, 1)",
    "duration-fast": "150ms",
    "duration-normal": "300ms",
    "duration-sheet": "400ms"
  },
  "visual-signature": {
    "hairline-dividers": "1px flat borders (#dddbd6) used structurally instead of card shadows",
    "task-checkbox": "Animated stroke drawing from 0 to 100% when complete, scaling micro-interaction",
    "bottom-sheet": "translateY slide-in overlay taking 60% of viewport height"
  },
  "accessibility": {
    "contrast_pairs": [
      {
        "usage": "Primary text on app background",
        "foreground": "var(--text-primary)",
        "background": "var(--background-app)",
        "content_kind": "text"
      },
      {
        "usage": "Secondary text on app background",
        "foreground": "var(--text-secondary)",
        "background": "var(--background-app)",
        "content_kind": "text"
      },
      {
        "usage": "Highlight text on app background",
        "foreground": "var(--highlight)",
        "background": "var(--background-app)",
        "content_kind": "text"
      },
      {
        "usage": "White text on highlight button",
        "foreground": "var(--white)",
        "background": "var(--highlight)",
        "content_kind": "text"
      }
    ]
  }
}